{{ header }}{{ column_left }}
<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <div class="pull-right">
                <button type="submit" form="form-seo" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
                <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
            <h1>{{ heading_title }}</h1>
            <ul class="breadcrumb">
                {% for breadcrumb in breadcrumbs %}
                    <li><a href="{{ breadcrumb['href'] }}">{{ breadcrumb['text'] }}</a></li>
                {% endfor %}
            </ul>
        </div>
    </div>
    <div class="container-fluid">
        {% if error_warning %}
            <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
        {% endif %}

        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_form }}</h3>
            </div>
            <div class="panel-body">
                <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-seo" class="form-horizontal">
                    <div class="form-group required">
                        <label class="col-sm-2 control-label" for="input-category">{{ entry_category }}</label>
                        <div class="col-sm-10">
                            <input type="text" name="category" value="" placeholder="{{ entry_category }}" id="input-category" class="form-control" />
                            <div id="seo-category" class="well well-sm" style="height: 100px; overflow: auto;">
                                {% if category %}
                                <div id="seo-category{{ category['category_id'] }}"><i class="fa fa-minus-circle"></i> {{ category['name'] }}
                                    <input type="hidden" name="category" value="{{ category['category_id'] }}" />
                                </div>
                                {% endif %}
                            </div>
                        </div>
                        {% if error_category %}
                            <div class="text-danger" style="padding-left: 20px">{{ error_category }}</div>
                        {% endif %}
                    </div>
                    <div class="form-group required">
                        <label class="col-sm-2 control-label" for="input-model">{{ entry_model }}</label>
                        <div class="col-sm-10">
                            <input type="text" name="model" value="" placeholder="{{ entry_model }}" id="input-model" class="form-control" />
                            <div id="seo-model" class="well well-sm" style="height: 100px; overflow: auto;">
                                {% if model %}
                                <div id="seo-model{{ model['model_id'] }}"><i class="fa fa-minus-circle"></i> {{ model['model_name'] }}
                                    <input type="hidden" name="model" value="{{ model['model_id'] }}" />
                                </div>
                                {% endif %}
                            </div>
                        </div>
                        {% if error_model %}
                            <div class="text-danger" style="padding-left: 20px">{{ error_model }}</div>
                        {% endif %}
                    </div>

                    <ul class="nav nav-tabs" id="language">
                        {% for language in languages %}
                            <li><a href="#language{{ language['language_id'] }}" data-toggle="tab">
                                    <img src="language/{{ language['code'] }}/{{ language['code'] }}.png" title="{{ language['name'] }}" /> {{ language['name'] }}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                    <div class="tab-content">
                        {% for language in languages %}
                        <div class="tab-pane" id="language{{ language['language_id'] }}">
                            <div class="form-group">
                                <label class="col-sm-2 control-label" for="description{{ language['language_id'] }}">{{ entry_description }}</label>
                                <div class="col-sm-10">
                                    <textarea name="description[{{ language['language_id'] }}][description]" placeholder="{{ entry_description }}"
                                              id="input-description{{ language['language_id'] }}"
                                              class="form-control summernote">{{ description[language['language_id']] is defined ? description[language['language_id']]['description'] : '' }}</textarea>
                                </div>
                            </div>
                            <div class="form-group required">
                                <label class="col-sm-2 control-label" for="input-meta-title{{ language['language_id'] }}">{{ entry_meta_title }}</label>
                                <div class="col-sm-10">
                                    <p>
                                        <button type="button" class="btn btn-default btn-xs button-model">{{ entry_model }}</button>
                                        <button type="button" class="btn btn-default btn-xs button-category">{{ entry_category }}</button>
                                    </p>
                                    <input type="text" name="description[{{ language['language_id'] }}][meta_title]"
                                           value="{{ description[language['language_id']] is defined ? description[language['language_id']]['meta_title'] : '' }}"
                                           placeholder="{{ entry_meta_title }}" id="input-meta-title{{ language['language_id'] }}" class="form-control" />
                                    {% if (error_meta_title[language['language_id']] is defined) %}
                                        <div class="text-danger">{{ error_meta_title[language['language_id']] }}</div>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-2 control-label" for="input-h1{{ language['language_id'] }}">{{ entry_html_h1 }}</label>
                                <div class="col-sm-10">
                                    <p><button type="button" class="btn btn-default btn-xs button-model">{{ entry_model }}</button> <button type="button" class="btn btn-default btn-xs button-category">{{ entry_category }}</button></p>
                                    <input type="text" name="description[{{ language['language_id'] }}][html_h1]" value="{{ description[language['language_id']] is defined ? description[language['language_id']]['html_h1'] : '' }}"
                                           placeholder="{{ entry_html_h1 }}" id="input-html-h1{{ language['language_id'] }}" class="form-control" />
                                </div>
                            </div>
                            <div class="form-group required">
                                <label class="col-sm-2 control-label" for="input-meta-description{{ language['language_id'] }}">{{ entry_meta_description }}</label>
                                <div class="col-sm-10">
                                    <p><button type="button" class="btn btn-default btn-xs button-model">{{ entry_model }}</button>
                                        <button type="button" class="btn btn-default btn-xs button-category">{{ entry_category }}</button></p>
                                    <textarea name="description[{{ language['language_id'] }}][meta_description]" rows="5"
                                              placeholder="{{ entry_meta_description }}" id="input-meta-description{{ language['language_id'] }}"
                                              class="form-control">{{ description[language['language_id']] is defined ? description[language['language_id']]['meta_description'] : '' }}</textarea>
                                    {% if (error_meta_description[language['language_id']] is defined) %}
                                        <div class="text-danger">{{ error_meta_description[language['language_id']] }}</div>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-2 control-label" for="input-meta-keyword{{ language['language_id'] }}">{{ entry_meta_keywords }}</label>
                                <div class="col-sm-10">
                                    <textarea name="description[{{ language['language_id'] }}][meta_keyword]" rows="5"
                                              placeholder="{{ entry_meta_keywords }}" id="input-meta-keyword{{ language['language_id'] }}"
                                              class="form-control">{{ description[language['language_id']] is defined ? description[language['language_id']]['meta_keyword'] : '' }}</textarea>
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>

                </form>
            </div>
        </div>
    </div>

    <script type="text/javascript" src="view/javascript/summernote/summernote.js"></script>
    <link href="view/javascript/summernote/summernote.css" rel="stylesheet" />
    <script type="text/javascript" src="view/javascript/summernote/opencart.js"></script>
    <script type="text/javascript"><!--
        $('#language a:first').tab('show');
        //-->

        var model = '{{ model is not empty ? model['model_name'] : '' }}';
        var category = '{{ category is not empty ? category['name'] : '' }}';

        // Category
        $('input[name=\'category\']').autocomplete({
            'source': function(request, response) {
                $.ajax({
                    url: 'index.php?route=catalog/category/autocomplete&user_token={{ user_token }}&filter_name=' +  encodeURIComponent(request),
                    dataType: 'json',
                    success: function(json) {
                        response($.map(json, function(item) {
                            return {
                                label: item['name'],
                                value: item['category_id']
                            }
                        }));
                    }
                });
            },
            'select': function(item) {
                $('input[name=\'category\']').val('');

                $('#seo-category' + item['value']).remove();

                $('#seo-category').html('<div id="seo-category' + item['value'] + '"><i class="fa fa-minus-circle"></i> ' + item['label'] + '<input type="hidden" name="category" value="' + item['value'] + '" /></div>');

                category = item['label'].split('>').pop().trim();
            }
        });

        $('#seo-category').delegate('.fa-minus-circle', 'click', function() {
            $(this).parent().remove();
        });

        // Model
        $('input[name=\'model\']').autocomplete({
            'source': function(request, response) {
                $.ajax({
                    url: 'index.php?route=extension/module/filter_auto/auto_models/autocomplete&user_token={{ user_token }}&filter_name=' +  encodeURIComponent(request),
                    dataType: 'json',
                    success: function(json) {
                        response($.map(json, function(item) {
                            return {
                                label: item['model_name'],
                                value: item['model_id']
                            }
                        }));
                    }
                });
            },
            'select': function(item) {
                $('input[name=\'model\']').val('');

                $('#seo-model' + item['value']).remove();

                $('#seo-model').html('<div id="seo-model' + item['value'] + '"><i class="fa fa-minus-circle"></i> ' + item['label'] + '<input type="hidden" name="model" value="' + item['value'] + '" /></div>');

                model = item['label'];
            }
        });

        $('#seo-model').delegate('.fa-minus-circle', 'click', function() {
            $(this).parent().remove();
        });

        $('.button-model').on('click', function(e) {
            addSeoText(this, model);
        });

        $('.button-category').on('click', function(e) {
            addSeoText(this, category);
        });

        function addSeoText(element, value)
        {
            let input = $(element).closest('.form-group').find('input');
            if (input.length) {
                input.val(input.val().concat(value));
            }

            let textarea = $(element).closest('.form-group').find('textarea');
            if (textarea.length) {
                textarea.val(textarea.val().concat(value));
            }
        }
    </script>
</div>
{{ footer }}