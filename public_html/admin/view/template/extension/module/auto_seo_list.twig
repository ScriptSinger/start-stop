{{ header }}{{ column_left }}
<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <div class="pull-right">
                <a href="{{ add }}" data-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary"><i class="fa fa-plus"></i></a>
                <button type="button" data-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger" onclick="confirm('{{ text_confirm }}') ? $('#form-seo').submit() : false;"><i class="fa fa-trash-o"></i></button>
            </div>
            <h1>{{ heading_title }}</h1>
            <ul class="breadcrumb">
                {% for breadcrumb in breadcrumbs %}
                <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
                {% endfor %}
            </ul>
        </div>
    </div>
    <div class="container-fluid">
        {% if error_warning %}
        <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
        {% endif %}

        <div class="alert alert-success alert-dismissible alert-slug" style="display: none;" role="alert">
            <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <div class="alert-slug-process">
                <i class="fa fa-spinner fa-spin fa-3x fa-fw"></i>
                <span class="sr-only">Loading...</span>
            </div>
            <div class="alert-slug-success" style="display: none;">{{ entry_generate_ok }}</div>
        </div>

        {% if success %}
        <div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
        {% endif %}

        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title"><i class="fa fa-list"></i> {{ text_list }}</h3>
            </div>
            <div class="panel-body">
                {% if no_slugs %}
                <div class="well">
                    <div class="form-group">
                        <h4>{{ entry_slug }}</h4>
                         <div class="alert alert-info"><i class="fa fa-info-circle"></i> {{ entry_slug_info }}
                         </div>
                         <button data-toggle="tooltip" id="slug_generate" class="btn btn-info" data-original-title="Обновить"><i class="fa fa-refresh"></i> {{ entry_generate }}</button>
                    </div>
                </div>
                {% endif %} 
                <div class="well">
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label class="control-label" for="input-ctegory">{{ entry_category }}</label>
                                <input type="text" name="filter_category_visible" value="{% if filter_category %} {{ filter_category.name }} {% endif %}" placeholder="{{ entry_category }}" id="input-category" class="form-control" />
                                <input type="hidden" name="filter_category">
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label class="control-label" for="input-model">{{ entry_model }}</label>
                                <input type="text" name="filter_model_visible" value="{% if filter_model %} {{ filter_model.model_name }} {% endif %}" placeholder="{{ entry_model }}" id="input-name" class="form-control" />
                                <input type="hidden" name="filter_model">
                            </div>
                            <button type="button" id="button-filter" class="btn btn-primary pull-right"><i class="fa fa-filter"></i> {{ button_filter }}</button>
                        </div>
                    </div>
                </div>

                <form action="{{ delete }}" method="post" enctype="multipart/form-data" id="form-seo">
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover">
                            <thead>
                                <tr>
                                    <td style="width: 1px;" class="text-center"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked);" /></td>
                                    <td class="text-left">
                                        {% if sort == 'cd.name' %}
                                            <a href="{{ sort_category }}" class="{{ order|lower }}">{{ column_category }}</a>
                                        {% else %}
                                            <a href="{{ sort_category }}">{{ column_category }}</a>
                                        {% endif %}
                                    </td>
                                    <td class="text-left">
                                        {% if sort == 'm.model_name' %}
                                            <a href="{{ sort_model }}" class="{{ order|lower }}">{{ column_model }}</a>
                                        {% else %}
                                            <a href="{{ sort_model }}">{{ column_model }}</a>
                                        {% endif %}
                                    </td>
                                    <td class="text-left">
                                        {% if sort == 'sd.meta_title' %}
                                            <a href="{{ sort_meta_title }}" class="{{ order|lower }}">{{ column_meta_title }}</a>
                                        {% else %}
                                            <a href="{{ sort_meta_title }}">{{ column_meta_title }}</a>
                                        {% endif %}
                                    </td>
                                    <td class="text-right">{{ column_action }}</td>
                                </tr>
                            </thead>
                            <tbody>
                                {% if seo_pages %}
                                    {% for page in seo_pages %}
                                    <tr>
                                        <td class="text-center">{% if page.seo_id in selected %}
                                                <input type="checkbox" name="selected[]" value="{{ page.seo_id }}" checked="checked" />
                                            {% else %}
                                                <input type="checkbox" name="selected[]" value="{{ page.seo_id }}" />
                                            {% endif %}
                                        </td>
                                        <td class="text-left">{{ page.name }}</td>
                                        <td class="text-left">{{ page.model_name }}</td>
                                        <td class="text-left">{{ page.meta_title }}</td>
                                        <td class="text-right"><a href="{{ page.edit }}" data-toggle="tooltip" title="{{ button_edit }}" class="btn btn-primary"><i class="fa fa-pencil"></i></a></td>
                                    </tr>
                                    {% endfor %}
                                {% else %}
                                <tr>
                                    <td class="text-center" colspan="5">{{ text_no_results }}</td>
                                </tr>
                                {% endif %}
                            </tbody>
                        </table>
                    </div>
                </form>
                <div class="row">
                    <div class="col-sm-6 text-left">{{ pagination }}</div>
                    <div class="col-sm-6 text-right">{{ results }}</div>
                </div>
            </div>
        </div>
    </div>
    <script type="text/javascript">
        (function () {
            var start = 0; 
            var iteration = 0;
            var model_count = {{ model_count }};
            var limit_model = {{ limit_model }};

            $('#slug_generate').on('click', function(e) {
                e.preventDefault();

                generateModelSlug(start, limit_model, iteration);
            });   

            function generateModelSlug(begin, count, i) {
                $.ajax({
                    url: 'index.php?route=extension/module/auto_seo/generate_slug&user_token={{ user_token }}',
                    type: 'post',
                    dataType: 'json',
                    data: {
                        start: begin,
                        limit: count,
                        iteration: i
                    },
                    beforeSend: function() {
                        $('.alert-slug').show();
                    },
                    success: function(json) {
                        if (json.success) {
                            if (model_count > (json.iteration * limit_model)) {
                                generateModelSlug(json.iteration * limit_model, limit_model, json.iteration);
                            } else {
                                generateBrandModuleSlug();
                            }
                        } else {
                            generateBrandModuleSlug();
                        }
                    },
                    error: function() {
                        alert('Server is down');
                    }
                });
            }

            function generateBrandModuleSlug() {
                $.ajax({
                    url: 'index.php?route=extension/module/auto_seo/generate_brandmodule_slug&user_token={{ user_token }}',
                    type: 'get',
                    success: function() {
                        $('.alert-slug-process').hide();
                        $('.alert-info').hide();
                        $('.alert-slug-success').show();
                    },
                    error: function() {
                        alert('Server is down');
                    }
                });
            } 

            $('#button-filter').on('click', function() {
                var url = 'index.php?route=extension/module/auto_seo&user_token={{ user_token }}';

                var filter_category = $('input[name=\'filter_category\']').val();

                if (filter_category) {
                    url += '&filter_category=' + encodeURIComponent(filter_category);
                }

                var filter_model = $('input[name=\'filter_model\']').val();

                if (filter_model) {
                    url += '&filter_model=' + encodeURIComponent(filter_model);
                }

                location = url;
            });

            $('input[name=\'filter_category_visible\']').autocomplete({
                'source': function(request, response) {
                    $.ajax({
                        url: 'index.php?route=catalog/category/autocomplete&user_token={{ user_token }}&filter_name=' +  encodeURIComponent(request),
                        dataType: 'json',
                        success: function(json) {
                            response($.map(json, function(item) {
                                return {
                                    label: item['name'],
                                    value: item['category_id']
                                }
                            }));
                        }
                    });
                },
                'select': function(item) {
                    $('input[name=\'filter_category_visible\']').val(item['label']);
                    $('input[name=\'filter_category\']').val(item['value']);
                }
            });

            $('input[name=\'filter_model_visible\']').autocomplete({
                'source': function(request, response) {
                    $.ajax({
                        url: 'index.php?route=extension/module/filter_auto/auto_models/autocomplete&user_token={{ user_token }}&filter_name=' +  encodeURIComponent(request),
                        dataType: 'json',
                        success: function(json) {
                            response($.map(json, function(item) {
                                return {
                                    label: item['model_name'],
                                    value: item['model_id']
                                }
                            }));
                        }
                    });
                },
                'select': function(item) {
                    $('input[name=\'filter_model_visible\']').val(item['label']);
                    $('input[name=\'filter_model\']').val(item['value']);
                }
            });
        })();    
    </script>
</div>
{{ footer }}