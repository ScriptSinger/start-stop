{{ header }}{{ column_left }}
<div id="content">
    <!-- Header-->
    <div class="page-header">
        <div class="container-fluid">
            <div class="pull-right">
                <button type="button" data-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger" onclick="confirm('{{ text_confirm }}') ? $('#form-models').submit() : false;"><i class="fa fa-trash-o"></i></button>
            </div>
            <h1>{{ heading_models }}</h1>
            <ul class="breadcrumb">
                {% for breadcrumb in breadcrumbs %}
                    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
                {% endfor %}
            </ul>
        </div>
    </div>
    <!-- /Header-->
    <!-- Content -->
    <div class="container-fluid">
        {% if error_warning %}
            <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
        {% endif %} 
        {% if success %}
            <div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }}
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
        <{% endif %}
        <div class="panel panel-default">
            <div class="panel-body">
                <div class="well">
                    <div class="row">
                        <div class="col-sm-4">
                            <div class="form-group">
                                <label class="control-label" for="input-brand">{{ heading_title }}</label>
                                <select name="filter_brand" id="input-brand" class="form-control">
                                    <option value="*"></option>
                                    {% if brands %}
                                        {% for brand in brands %}
                                            <option value="{{ brand.brand_id }}" {% if brand.brand_id == filter_brand %} selected="selected" {% endif %}>{{ brand.brand_name }}</option>
                                        {% endfor %}
                                    {% endif %}
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-3">
                            <button type="button" id="button-filter" class="btn btn-primary pull-left"><i class="fa fa-filter"></i> {{ button_filter }}</button>
                        </div>
                    </div>
                </div>
                <div class="well">
                    {% if filter_brand %}
                        <div class="row">
                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label class="control-label" for="model-name">{{ column_name }}</label>
                                    <input type="text" id="model-name" class="form-control require" value="">
                                </div>
                            </div>
                            <div class="col-sm-2">
                                <div class="form-group">
                                    <label class="control-label" for="model-start">{{ column_date_start }}</label>
                                    <input type="text" id="model-start" class="form-control" value="" placeholder="{{ column_date_plh }}">
                                </div>
                            </div>
                            <div class="col-sm-2">
                                <div class="form-group">
                                    <label class="control-label" for="model-end">{{ column_date_end }}</label>
                                    <input type="text" id="model-end" class="form-control" value="" placeholder="{{ column_date_plh }}">
                                </div>
                            </div>
                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label class="control-label" for="model-status">{{ column_status }}</label>
                                    <select class="form-control" id="model-status">
                                        <option value="1">{{ text_enabled }}</option>
                                        <option value="0">{{ text_disabled }}</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-2">
                                <div class="form-group">
                                    <label></label>
                                    <button id="model-save" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary form-control"><i class="fa fa-save"></i> {{ button_save }}</button>
                                    <input type="hidden" id="brand-id" class="form-control" value="{{ filter_brand }}">
                                </div>
                            </div>
                        </div>
                    {% else %}
                        {{ text_no_filter }}
                    {% endif %}
                </div>

                {% if models %}
                <form action="{{ delete }}" method="post" enctype="multipart/form-data" id="form-models">
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover">
                            <thead>
                            <tr>
                                <td style="width: 1px;" class="text-center"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked);" /></td>
                                <td class="text-left">{{ column_name }}</td>
                                <td class="text-left">{{ column_date }}</td>
                                <td class="text-left">{{ column_status }}</td>
                                <td class="text-right">{{ column_action }}</td>
                            </tr>
                            </thead>
                            <tbody>
                                {% for model in models %}
                                    <tr>
                                        <td class="text-center">
                                            <input type="checkbox" name="selected[]" value="{{ model.model_id }}" />
                                        </td>
                                        <td class="text-left">{{ model.model_name }}</td>
                                        <td class="text-left">{{ model.model_start }} - {{ model.model_end }}</td>
                                        <td class="text-left">{{ model.status }}</td>
                                        <td class="text-right"><a href="{{ model.edit }}" data-toggle="tooltip" title="{{ button_edit }}" class="btn btn-primary"><i class="fa fa-pencil"></i></a></td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </form>
                {% else %}
                    {{ text_no_results }}
                {% endif %}

            </div>
        </div>
    </div>
    <!-- /Content -->
</div>
<script><!--
    var url = 'index.php?route=extension/module/filter_auto/auto_models&user_token={{ user_token }}';

    $('#button-filter').on('click', function() {

        var filter_brand = $("select[name='filter_brand']").val();

        if (filter_brand != '*') {
            url += '&filter_brand=' + encodeURIComponent(filter_brand);
        }

        location = url;
    });

    $('#model-save').on('click', function() {
        var brand_id = $('#brand-id').val();
        var model_name = $('#model-name');
        var model_start = $('#model-start');
        var model_end = $('#model-end');
        var model_status = $('#model-status');

        var error = false;

        $('.require').each(function() {
            if (!$(this).val()) {
                $(this).closest('.form-group').addClass('has-error');
                error = true;
            } else {
                $(this).closest('.form-group').removeClass('has-error');
                error = false;
            }

        });

        if (!error) {
            $.ajax({
                url: '/admin/index.php?route=extension/module/filter_auto/auto_models/add&user_token={{ user_token }}',
                type: 'POST',
                dataType: 'json',
                data: {
                    brand_id: brand_id,
                    model_name: model_name.val(),
                    model_start: model_start.val(),
                    model_end: model_end.val() || 0,
                    model_status: model_status.val(),
                    image: ''
                },
                success: function(data) {
                    if (data.result) {
                        location.reload();
                    }
                },
                error: function() {
                    alert('Server is down');
                }
            });
        }
    });

//--></script>
{{ footer }}