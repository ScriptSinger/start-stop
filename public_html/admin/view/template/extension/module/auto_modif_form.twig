{{ header }}{{ column_left }}
<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <div class="pull-right">
                <button type="submit" form="form-modif" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
                <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
            <h1>{{ modif_edit }}</h1>
            <ul class="breadcrumb">
                {% for breadcrumb in breadcrumbs %}
                    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
                {% endfor %}
            </ul>
        </div>
    </div>
    <div class="container-fluid">
        {% if error_warning %}
            <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
        {% endif %}

        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_form }}</h3>
            </div>
            <div class="panel-body">
                <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-model" class="form-horizontal">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group required">
                                <label class="col-sm-2 control-label" for="input-name">{{ column_name }}</label>
                                <div class="col-sm-8">
                                    <input type="text" name="modif[modif_name]" value="{% if modif.modif_name %} {{ modif.modif_name }} {% endif %}" placeholder="{{ column_name }}" id="input-name" class="form-control" />
                                    {% if error_name %}
                                        <div class="text-danger">{{ error_name }}</div>
                                    {% endif %}
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-2 control-label" for="input-dvs">{{ column_dvs }}</label>
                                <div class="col-sm-8">
                                    <input type="text" name="modif[modif_dvs]" value="{% if modif.modif_dvs %} {{ modif.modif_dvs}} {% endif %}" placeholder="{{ column_dvs }}" id="input-dvs" class="form-control" />
                                    {% if error_dvs %}
                                        <div class="text-danger">{{ error_dvs }}</div>
                                    {% endif %}
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-2 control-label" for="input-hp">{{ column_hp }}</label>
                                <div class="col-sm-8">
                                    <input type="text" name="modif[modif_hp]" value="{% if modif.modif_hp %} {{ modif.modif_hp}} {% endif %}" placeholder="{{ column_hp }}" id="input-hp" class="form-control" />
                                    {% if error_hp %}
                                        <div class="text-danger">{{ error_hp }}</div>
                                    {% endif %}
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-2 control-label" for="input-body">{{ column_body }}</label>
                                <div class="col-sm-8">
                                    <input type="text" name="modif[modif_body]" value="{% if modif.modif_body %} {{ modif.modif_body }} {% endif %}" placeholder="{{ column_body }}" id="input-body" class="form-control" />
                                    {% if error_body %}
                                        <div class="text-danger">{{ error_body }}</div>
                                    {% endif %}
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-2 control-label" for="input-start">{{ column_date_start }}</label>
                                <div class="col-sm-8">
                                    <input type="text" name="modif[modif_start]" value="{% if modif.modif_start %} {{ modif.modif_start }} {% endif %}" placeholder="{{ column_date_plh }}" id="input-start" class="form-control" />
                                    {% if error_start %}
                                        <div class="text-danger">{{ error_start }}</div>
                                    {% endif %}
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-2 control-label" for="input-end">{{ column_date_end }}</label>
                                <div class="col-sm-8">
                                    <input type="text" name="modif[modif_end]" value="{% if modif.modif_end %} {{ modif.modif_end }} {% endif %}" placeholder="{{ column_date_plh }}" id="input-end" class="form-control" />
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
                                <div class="col-sm-3">
                                    <select name="status" id="input-status" class="form-control">
                                        {% if modif.active %}
                                            <option value="1" selected="selected">{{ text_enabled }}</option>
                                            <option value="0">{{ text_disabled }}</option>
                                        {% else %}
                                            <option value="1">{{ text_enabled }}</option>
                                            <option value="0" selected="selected">{{ text_disabled }}</option>
                                        {% endif %}
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>
{{ footer }}