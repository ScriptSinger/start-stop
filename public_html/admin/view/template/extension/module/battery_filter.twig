{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-module" data-toggle="tooltip" title="Сохранить" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="Отмена" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
    </div>
  </div>
  <div class="container-fluid">
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> Управление модулем</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-module" class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">Статус</label>
            <div class="col-sm-10">
              <select name="module_battery_filter_status" id="input-status" class="form-control">
                <option value="1" {% if module_battery_filter_status %}selected="selected"{% endif %}>Включено</option>
                <option value="0" {% if not module_battery_filter_status %}selected="selected"{% endif %}>Отключено</option>
              </select>
            </div>
          </div>
          <div class="alert alert-info">
            Модуль подтягивает данные из таблицы <b>oc_battery_base</b>. После включения вы сможете выбрать его в разделе Дизайн -> Макеты.
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}